# ================================
# Environment Configuration for Staging
# ================================

NODE_ENV=staging

# ===============================
# PostgreSQL Database Configuration
# ===============================

DATABASE_TYPE=postgres
DATABASE_HOST=postgres # (pode ser o nome do serviço definido no docker-compose, ex: postgres)
DATABASE_PORT=5432 # (pode ser a mesma do LOCAL_PORT_DB e DOCKER_PORT_DB)
DATABASE_DB=axion_staging_db
DATABASE_USER=axion_staging_user
DATABASE_PASSWORD=axion_staging_password
DATABASE_SYNCHRONIZE=0 # (pode ser 1 ou 0, dependendo se deseja sincronizar o banco de dados automaticamente)
DATABASE_AUTO_LOAD_ENTITIES=0 # (pode ser 1 ou 0, dependendo se deseja carregar as entidades automaticamente)

# ===============================
# Port Configuration
# ===============================

LOCAL_PORT_APP=3001
DOCKER_PORT_APP=3001

LOCAL_PORT_DB=5434
DOCKER_PORT_DB=5432