# ================================
# Environment Configuration for Staging
# ================================

NODE_ENV=staging

# ===============================
# PostgreSQL Database Configuration
# ===============================

POSTGRES_TYPE=postgres
POSTGRES_HOST=AXION_STAGING_POSTGRES_HOST # (pode ser o nome do serviço definido no docker-compose, ex: postgres)
POSTGRES_PORT=AXION_STAGING_DB_PORT # (pode ser a mesma do LOCAL_PORT_DB e DOCKER_PORT_DB)
POSTGRES_DB=AXION_STAGING_DB
POSTGRES_USER=AXION_STAGING_USER
POSTGRES_PASSWORD=AXION_STAGING_PASSWORD
POSTGRES_SYNCHRONIZE=0 # (pode ser 1 ou 0, dependendo se deseja sincronizar o banco de dados automaticamente)
POSTGRES_AUTO_LOAD_ENTITIES=0 # (pode ser 1 ou 0, dependendo se deseja carregar as entidades automaticamente)

# ===============================
# Port Configuration
# ===============================

LOCAL_PORT_APP=3001
DOCKER_PORT_APP=3001

LOCAL_PORT_DB=CHOOSE_YOUR_LOCAL_DB_PORT
DOCKER_PORT_DB=CHOOSE_YOUR_DOCKER_DB_PORT