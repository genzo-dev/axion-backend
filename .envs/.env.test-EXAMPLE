# ================================
# Environment Configuration for Development
# ================================

NODE_ENV=test

# ================================
# Urls
# ================================

FRONT_URL=http://localhost:3000

# ===============================
# PostgreSQL Database Configuration
# ===============================

DATABASE_TYPE=postgres
DATABASE_HOST=postgres # (pode ser o nome do serviço definido no docker-compose, ex: postgres)
DATABASE_PORT=5432 # (pode ser a mesma do LOCAL_PORT_DB e DOCKER_PORT_DB)
DATABASE_DB=axion_test_db
DATABASE_USER=axion_test_user
DATABASE_PASSWORD=axion_test_password
DATABASE_SYNCHRONIZE=1 # (pode ser 1 ou 0, dependendo se deseja sincronizar o banco de dados automaticamente)
DATABASE_AUTO_LOAD_ENTITIES=1 # (pode ser 1 ou 0, dependendo se deseja carregar as entidades automaticamente)

# ===============================
# Port Configuration
# ===============================

LOCAL_PORT_APP=3001
DOCKER_PORT_APP=3001

LOCAL_PORT_DB=5433
DOCKER_PORT_DB=5432

# ===============================
# JWT Config
# ===============================

JWT_SECRET=axion_test_senha_supersecreta
JWT_TOKEN_AUDIENCE=http://localhost:3001
JWT_TOKEN_ISSUER=http://localhost:3001
JWT_TTL=900 # 15 minutos
JWT_REFRESH_TTL=604800 # 1 semana

# JWT Reset Password Config

JWT_RESET_PASSWORD_SECRET=axion_test_senha_supersecreta_reset_password
JWT_TTL_RESET_PASSWORD=900 # 15 minutos

# ===============================
# Email Config
# ===============================

EMAIL_CODE_EXPIRES_AT=900 # 15 minutos
EMAIL_CODE_RESEND_BLOCK_TIME=30 # 30 segundos
EMAIL_RESEND_API_KEY=re_BNF6En1c_LY21P7n73SVYXGY7MfL4BQet