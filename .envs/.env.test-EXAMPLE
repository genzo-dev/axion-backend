# ================================
# Environment Configuration for Development
# ================================

NODE_ENV=test

# ===============================
# PostgreSQL Database Configuration
# ===============================

POSTGRES_TYPE=postgres
POSTGRES_HOST=AXION_TEST_POSTGRES_HOST # (pode ser o nome do serviço definido no docker-compose, ex: postgres)
POSTGRES_PORT=AXION_TEST_DB_PORT # (pode ser a mesma do LOCAL_PORT_DB e DOCKER_PORT_DB)
POSTGRES_DB=AXION_TEST_DB
POSTGRES_USER=AXION_TEST_USER
POSTGRES_PASSWORD=AXION_TEST_PASSWORD
POSTGRES_SYNCHRONIZE=1
POSTGRES_AUTO_LOAD_ENTITIES=1

# ===============================
# Port Configuration
# ===============================

LOCAL_PORT_APP=3001
DOCKER_PORT_APP=3001

LOCAL_PORT_DB=5433
DOCKER_PORT_DB=5432