# ================================
# Environment Configuration for Staging
# ================================

NODE_ENV=staging

# ===============================
# PostgreSQL Database Configuration
# ===============================

POSTGRES_TYPE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=axion_staging_db
POSTGRES_USER=axion_staging_user
POSTGRES_PASSWORD=axion_staging_password
POSTGRES_SYNCHRONIZE=0
POSTGRES_AUTO_LOAD_ENTITIES=0

# ===============================
# Port Configuration
# ===============================

LOCAL_PORT_APP=3001
DOCKER_PORT_APP=3001

LOCAL_PORT_DB=5434
DOCKER_PORT_DB=5432