# ================================
# Environment Configuration for Staging
# ================================

NODE_ENV=staging

# ===============================
# PostgreSQL Database Configuration
# ===============================

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=axion_staging_db
DATABASE_USER=axion_staging_user
DATABASE_PASSWORD=axion_staging_password
DATABASE_SYNCHRONIZE=0
DATABASE_AUTO_LOAD_ENTITIES=0

# ===============================
# Port Configuration
# ===============================

LOCAL_PORT_APP=3001
DOCKER_PORT_APP=3001

LOCAL_PORT_DB=5434
DOCKER_PORT_DB=5432