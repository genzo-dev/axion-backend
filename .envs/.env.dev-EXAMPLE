# ================================
# Environment Configuration for Development
# ================================

NODE_ENV=development

# ===============================
# PostgreSQL Database Configuration
# ===============================

POSTGRES_TYPE=postgres
POSTGRES_HOST=postgres # (pode ser o nome do serviço definido no docker-compose, ex: postgres)
POSTGRES_PORT=5432 # (pode ser a mesma do LOCAL_PORT_DB e DOCKER_PORT_DB)
POSTGRES_DB=axion_dev_db
POSTGRES_USER=axion_dev_user
POSTGRES_PASSWORD=axion_dev_password
POSTGRES_SYNCHRONIZE=1 # (pode ser 1 ou 0, dependendo se deseja sincronizar o banco de dados automaticamente)
POSTGRES_AUTO_LOAD_ENTITIES=1 # (pode ser 1 ou 0, dependendo se deseja carregar as entidades automaticamente)

# ===============================
# Port Configuration
# ===============================

LOCAL_PORT_APP=3001
DOCKER_PORT_APP=3001

LOCAL_PORT_DB=5432
DOCKER_PORT_DB=5432